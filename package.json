{
  "name": "bpsc-tre-practice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "cp index.template.html index.html && vite",
    "build": "tsc -b && cp index.template.html index.html && vite build && cp dist/index.html index.html && cp -r dist/assets .",
    "lint": "tsc -b --pretty false",
    "preview": "vite preview",
    "ingest": "python3 scripts/auto_ingest.py",
    "sync": "./sync.sh"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
